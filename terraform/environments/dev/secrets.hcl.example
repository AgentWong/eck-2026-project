# Copy this file to secrets.hcl and fill in your values.
# secrets.hcl is gitignored and must NOT be committed.

locals {
  # AWS Account & Infrastructure
  aws_account_id       = "YOUR_AWS_ACCOUNT_ID"           # e.g. "123456789012"
  hosted_zone_id       = "YOUR_HOSTED_ZONE_ID"           # e.g. "Z0XXXXXXXXXXXXXXXXXX"
  acm_certificate_arn  = "YOUR_ACM_CERTIFICATE_ARN"      # e.g. "arn:aws:acm:us-west-2:123456789012:certificate/uuid"
  terraform_state_bucket = "YOUR_TERRAFORM_STATE_BUCKET" # e.g. "terraform-state-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
}
